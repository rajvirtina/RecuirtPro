# Environment variables
VITE_API_URL=http://localhost:5001/api
VITE_WS_URL=ws://localhost:5001
VITE_SOCKET_URL=http://localhost:5001
VITE_ENABLE_PROCTORING=true
VITE_APP_NAME=RecuirtPro

# Observability — Sentry error tracking (frontend)
# Set to your Sentry project DSN; leave blank to disable
VITE_SENTRY_DSN=

# TURN server for WebRTC — required for users behind corporate firewalls / strict NAT.
# Self-host with coturn (see docker-compose.yml coturn service) or use a managed provider.
# In development, leave blank to fall back to the free openrelay.metered.ca TURN servers.
VITE_TURN_SERVER_URL=turn:YOUR_VPS_IP:3478
VITE_TURN_USERNAME=recruitpro
VITE_TURN_PASSWORD=your-strong-turn-password-here
