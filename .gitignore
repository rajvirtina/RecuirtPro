# Dependencies
node_modules/
**/node_modules/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.hostinger
**/.env.local
**/.env.development
**/.env.staging
# .env files contain real secrets — must never be committed
backend/.env
backend/.env.production
# frontend/.env.production contains only public URLs (no secrets) — allowed for Hostinger build
!frontend/.env.production

# Build outputs — generated by CI; never commit compiled JS
build/
**/build/
dist/
**/dist/
# Legacy Hostinger deploy artifacts (untrack with: git rm -r --cached deploy/ backend/app.js)
deploy/dist/
deploy/app.js
backend/app.js

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*.swn
.vs/

# Testing
coverage/
.nyc_output/

# Uploads
uploads/
temp/

# Cache
.eslintcache
.cache/

# MongoDB
data/

# Backup files
*.backup
*.bak

